# Copie este arquivo pra `.env` e ajuste conforme o ambiente.
# Nenhuma variável aqui é obrigatória — sem `.env`, o servidor usa os
# defaults de desenvolvimento (porta 3001, CORS liberado pra qualquer origem).

# Porta em que o backend escuta.
PORT=3001

# Origem permitida pra chamadas do frontend (CORS). Em produção, aponte pra
# URL real do frontend, ex.: https://barberpro.exemplo.com.br
CORS_ORIGIN=*

# Caminho do arquivo do banco SQLite. Use ':memory:' pra um banco efêmero
# (é o que a suíte de testes faz automaticamente, sem precisar mexer aqui).
# DB_PATH=./data/barberpro.db
