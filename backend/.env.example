# Copie este arquivo pra `.env` e ajuste conforme o ambiente.
# `.env` nunca deve ser commitado — já está no .gitignore.

# Porta em que o backend escuta. No Render isso é injetado automaticamente
# (a plataforma define PORT sozinha); só precisa setar aqui em dev local se
# quiser mudar da 3001 padrão.
PORT=3001

# Origem permitida pra chamadas do frontend (CORS). Em produção, aponte pra
# URL real do frontend no Netlify, ex.: https://barberpro.netlify.app
# Sem essa variável, libera qualquer origem (bom só em dev local).
CORS_ORIGIN=*

# Connection string do Postgres (Neon, Render Postgres, ou qualquer outro).
# Obrigatória — o servidor não sobe sem ela (exceto em teste, que usa um
# banco Postgres em memória via pg-mem, sem precisar de conexão real).
# Pegue a sua no painel do Neon em "Connection string" (aba "Pooled connection").
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Senha única do painel de gestão (não é login por pessoa — é uma senha só,
# que qualquer barbeiro/recepção usa igual, pra barrar visitante casual que
# ache a URL do painel). Obrigatória — sem ela, TODO o painel fica bloqueado
# (menos a tela pública /agendar, que não precisa de senha nenhuma).
# Escolha qualquer senha sua, não precisa ser essa aqui embaixo.
PANEL_PASSWORD=troque-esta-senha
